<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:minHeight="36dp">

    <ImageView
        android:id="@+id/widget_done_checkbox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/widget_checkbox_off"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_task_done" />

    <TextView
        android:id="@+id/widget_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_pending_sync"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@android:drawable/ic_popup_sync"
        android:visibility="gone"
        android:contentDescription="@string/widget_pending_sync_desc"
        android:alpha="0.7" />

</LinearLayout>
